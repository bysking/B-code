{
  "name": "@bysking/b-code",
  "version": "3.4.5",
  "description": "从零构建的编码助手 — 你自己的 B-Code，运行在终端里（要求 Node.js >= 24, 推荐>=26.2.0）",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "bcode": "./bin/bcode.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "node build-bun.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 20000",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "check:version": "node scripts/check-version.js && node scripts/sync-version.js --check",
    "version:sync": "node scripts/sync-version.js",
    "prepublishOnly": "npm run typecheck && npm run check:version",
    "build:all-check": "node build-bun.js --all-check"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysking/b-code.git"
  },
  "homepage": "https://github.com/bysking/b-code#readme",
  "keywords": [
    "bcode",
    "coding-agent",
    "b-code",
    "ai",
    "terminal",
    "agent",
    "mcp",
    "@bysking/b-code",
    "bysking"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@devhub-io/latex-to-unicode": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentui/core": "0.8.2",
    "@opentui/react": "0.8.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "marked": "^9.1.6",
    "marked-terminal": "^6.2.0",
    "react": "^19.3.1",
    "undici": "^6.28.0",
    "wrap-ansi": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "_comment_optionalDependencies": "平台包依赖由 scripts/sync-version.js 在 prepack 时按 version 自动注入，源文件不再维护——改版本只需改上面的 version 一处。",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "optionalDependencies": {
    "@bysking/b-code-darwin-arm64": "3.4.5",
    "@bysking/b-code-darwin-x64": "3.4.5",
    "@bysking/b-code-linux-x64": "3.4.5",
    "@bysking/b-code-win32-x64": "3.4.5"
  }
}
