{
  "name": "@bysking/b-code",
  "version": "0.1.9",
  "description": "从零构建的编码助手 — 你自己的 B-Code，运行在终端里",
  "type": "module",
  "main": "dist/cli.mjs",
  "bin": {
    "bcode": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node build.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-force-exit --test-concurrency=1 test/*.test.ts test/*.test.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysking/b-code.git"
  },
  "homepage": "https://github.com/bysking/b-code#readme",
  "keywords": [
    "bcode",
    "coding-agent",
    "b-code",
    "ai",
    "terminal",
    "agent",
    "mcp",
    "@bysking/b-code",
    "bysking"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@devhub-io/latex-to-unicode": "^2.0.1",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "marked": "^9.1.6",
    "marked-terminal": "^6.2.0",
    "react": "^19.2.8",
    "undici": "^6.28.0",
    "wrap-ansi": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.25.12",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
