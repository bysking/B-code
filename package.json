{
  "name": "@bysking/b-code",
  "version": "2.0.2",
  "description": "从零构建的编码助手 — 你自己的 B-Code，运行在终端里",
  "type": "module",
  "main": "dist/cli.mjs",
  "bin": {
    "bcode": "./bin/bcode.js"
  },
  "files": [
    "bin",
    "dist/cli.mjs"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "node build.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 20000",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run typecheck && npm run build",
    "build:bun": "node build-bun.js",
    "build:all-check": "node build-bun.js --all-check"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysking/b-code.git"
  },
  "homepage": "https://github.com/bysking/b-code#readme",
  "keywords": [
    "bcode",
    "coding-agent",
    "b-code",
    "ai",
    "terminal",
    "agent",
    "mcp",
    "@bysking/b-code",
    "bysking"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@devhub-io/latex-to-unicode": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentui/core": "0.8.2",
    "@opentui/react": "0.8.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "marked": "^9.1.6",
    "marked-terminal": "^6.2.0",
    "react": "^19.3.1",
    "undici": "^6.28.0",
    "wrap-ansi": "^10.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@bysking/b-code-darwin-arm64": "2.0.2",
    "@bysking/b-code-darwin-x64": "2.0.2",
    "@bysking/b-code-linux-x64": "2.0.2",
    "@bysking/b-code-win32-x64": "2.0.2"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
