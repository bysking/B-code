{
  "name": "b-code",
  "version": "0.1.0",
  "description": "A coding agent built from scratch — your own Claude Code",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "bcode": "bin/bcode.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
