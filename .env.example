# 复制为 .env 后填入真实值

# Anthropic 原生后端（未配置 OPENAI_BASE_URL 时使用）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# OpenAI 兼容后端（有 OPENAI_API_KEY + OPENAI_BASE_URL 时优先生效）
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:4321/v1

# 可选：覆盖默认模型名
# B_CODE_MODEL=gpt-4o-mini

# 可选：数据根目录覆盖（默认 ~/.b-code；测试 / CI / 换机迁移用）
# B_CODE_HOME=/path/to/b-code-data

# 可选：技能目录层（搜索链：项目 .claude/skills > 此项 > $B_CODE_HOME/skills > ~/.claude/skills）
# B_CODE_SKILLS_DIR=/path/to/skills
# 可选：MCP 配置覆盖（搜索链：此项 > 项目 .claude/mcp.json > $B_CODE_HOME/mcp.json）
# B_CODE_MCP_CONFIG=/path/to/mcp.json

# 可选：日志级别 debug|info|warn|error（默认 info）
# B_CODE_LOG_LEVEL=debug
# B_CODE_LOG_FILE=1   # 非空即启用日志落盘到 {B_CODE_HOME}/logs/